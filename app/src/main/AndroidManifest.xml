<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Marks this as a TV app. Google TV only shows apps with a leanback launcher entry. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <!-- TVs have no touchscreen; without this the app would be "incompatible" with them. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Over-the-air updates: lets Lumen hand a downloaded update to Android's installer.
         The user still has to allow it once ("Install unknown apps") and confirm each update. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Backups are off: sources hold credentials, which must stay on this device.
         allowBackup covers API 29-30, dataExtractionRules covers 31+. -->
    <application
        android:name=".LumenApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lumen"
        tools:ignore="DataExtractionRules">

        <!-- configChanges: remotes/keyboards connecting count as config changes; handle them
             in-place instead of letting Android destroy and recreate the Activity. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hears back from Android's installer while an update installs. -->
        <receiver
            android:name=".data.update.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
