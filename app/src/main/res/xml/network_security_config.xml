<?xml version="1.0" encoding="utf-8"?>
<!-- Android blocks plain http:// by default (like iOS App Transport Security).
     IPTV playlists and streams are very often http://, and they're user-supplied,
     so cleartext is allowed app-wide. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
