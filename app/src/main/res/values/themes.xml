<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window-level theme only: paints the window near-black before Compose draws,
         so launch never flashes white. All real styling lives in Compose (ui/theme). -->
    <style name="Theme.Lumen" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>
</resources>
